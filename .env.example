# Solo per provare il bot da PC: su GitHub Actions queste chiavi sono secret del repository (vedi README).

# Telegram: token di @BotFather. Il primo che scrive /start al bot ne diventa il proprietario.
TELEGRAM_BOT_TOKEN=
# facoltativo: il chat id del proprietario (altrimenti è il primo /start)
TELEGRAM_CHAT_ID=

# eBay (facoltativo): senza queste chiavi eBay non viene cercato.
# https://developer.ebay.com/my/keys  (App ID = Client ID, Cert ID = Client Secret, ambiente Production)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Percorsi (di default dentro ./data)
# POKEBOT_DB_PATH=./data/pokebot.db
