# --- Telegram (obbligatorio per ricevere le notifiche) ---
# scrivi a @BotFather su Telegram, /newbot, copia il token. Poi manda /start al bot: la chat viene salvata da sola.
TELEGRAM_BOT_TOKEN=
# facoltativo: se impostato, il bot accetta comandi solo da questa chat
TELEGRAM_CHAT_ID=

# --- eBay (opzionale): con le credenziali usa l'API ufficiale Browse invece dello scraping HTML ---
# https://developer.ebay.com/my/keys  (App ID = Client ID, Cert ID = Client Secret, ambiente Production)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# --- Interfaccia web ---
POKEBOT_HOST=0.0.0.0
POKEBOT_PORT=8080
POKEBOT_SECRET=cambia-questa-stringa

# --- Percorsi (di default dentro ./data) ---
# POKEBOT_DB_PATH=./data/pokebot.db
